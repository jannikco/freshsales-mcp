        "name": "freshsales_get_contact",
        "description": "Read one contact by its authorized numeric ID.",
        "method": "GET",
        "path": "/contacts/{id}",
        "readOnly": true,
        "approvalRequired": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
            "id"
          ],
          "query": {},
          "body": {}
        },
        "sampleArguments": {
          "id": 1001
        },
        "evidence": {
          "state": "documented",
          "providerLiveValidation": "not-run"
        },
        "provenance": [
          "https://developers.freshworks.com/crm/api/"
        ]
      },
      {
        "name": "freshsales_create_contact",
        "description": "Create a CRM contact, subject to account-specific required fields.",
        "method": "POST",
        "path": "/contacts",
        "readOnly": false,
        "approvalRequired": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "minLength": 1
            },
            "last_name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          },
          "required": [
            "first_name",
            "last_name",
            "email"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "first_name": "contact.first_name",
            "last_name": "contact.last_name",
            "email": "contact.email"
          }
        },
        "sampleArguments": {
          "first_name": "Sandbox",
          "last_name": "Example",
          "email": "sandbox@example.com"
        },
        "evidence": {
          "state": "documented",
          "providerLiveValidation": "not-run"
        },
        "provenance": [
          "https://developers.freshworks.com/crm/api/"
        ]
      }
